# Copy this file to .env.local and fill in each line. .env.local is private: never put it in Git,
# mail or chat. Where to find each value is explained in docs/SETUP.md.

# Supabase (the database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key of Supabase: server only
SUPABASE_SERVICE_ROLE_KEY=

# A long random text that signs the sign-in cookie. REQUIRED on a live server.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Private files in Amazon S3 (leave empty to keep using Supabase Storage); see docs/STORAGE.md
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Outgoing mail (acknowledgements, hall ticket and letter notices, sign-in details)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Testing only: lets the main administrator clear test data (Administration, Clear test data).
# Leave empty, and remove from the live site, for real use.
ALLOW_TEST_DATA_RESET=
